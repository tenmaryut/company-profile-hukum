[Unit]
Description=Nalar Saksama (company-profile-hukum): worker queue Laravel
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/web/company-profile-hukum
ExecStart=/usr/bin/php artisan queue:work database --sleep=3 --tries=3 --max-time=3600 --memory=192
Restart=always
RestartSec=5
UMask=0022

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/web/company-profile-hukum/storage /srv/web/company-profile-hukum/bootstrap/cache /var/lib/company-profile-hukum
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
SystemCallArchitectures=native
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
