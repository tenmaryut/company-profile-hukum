# Situs demo kantor hukum fiktif "Nalar Saksama" (Laravel + Filament).
# Template: deploy/company-profile-hukum.caddy.tmpl. deploy/deploy.sh mengisi alamat situs dengan host
# dari HUKUM_URL di /root/tenma-ws/portofolio/domain.env, lalu memasangnya ke /etc/caddy/sites/.
# Ubah di repo, bukan di /etc.

__HUKUM_HOST__ {
	import gerbang_staging
	root * /srv/web/company-profile-hukum/public
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
		-X-Powered-By
		-Via
	}

	# Situs publik tanpa JavaScript dan tanpa style inline: CSP ketat.
	@public not path /admin /admin/* /livewire* /filament/*
	header @public Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"

	# Panel Filament (Livewire + Alpine) butuh script/style inline dan eval.
	@admin path /admin /admin/* /livewire* /filament/*
	header @admin Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"

	# Aset ber-hash (Vite) dan aset Filament yang di-versioning.
	@hashed path /build/* /js/filament/* /css/filament/* /fonts/filament/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	@images path /storage/* /images/* /favicon.svg /favicon.ico /apple-touch-icon.png
	header @images Cache-Control "public, max-age=604800"

	# File tersembunyi (mis. .env, .htaccess) tidak pernah disajikan.
	@dotfiles path */.*
	respond @dotfiles 404

	php_fastcgi unix//run/php/company-profile-hukum.sock
	file_server
}
